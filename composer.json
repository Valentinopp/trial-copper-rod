{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "indoprima/wip-laravel-app",
  "type": "project",
  "description": "Digital WIP Coiling Board - Laravel 12 and Livewire 3",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "livewire/livewire": "^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.13",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "backend/app/",
      "Database\\Factories\\": "backend/database/factories/",
      "Database\\Seeders\\": "backend/database/seeders/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "vendor-dir": "backend/vendor"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
